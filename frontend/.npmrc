# CI and the Docker builds install the frontend WITHOUT a lockfile (see
# npm/cli#4828 in the Dockerfiles), so every build resolves the tree fresh
# against the live registry. npm 10's peer resolver crashes ("Cannot read
# properties of null (reading 'edgesOut')") when an OPTIONAL peer's own peers
# can't be placed — vitest's optional @vitest/browser*/@vitest/ui peers did
# exactly that the day vitest 5 shipped, and broke every build with an
# unchanged package.json. Our real peers (svelte, vite) are explicit
# devDependencies, so skipping automatic peer placement loses nothing.
legacy-peer-deps=true
